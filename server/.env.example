# CloudReady AI - Backend Environment Configuration Example
# Copy this file to .env before starting the server:
#   cp .env.example .env

# Server port (default: 3000)
PORT=3000

# AI Provider Selection
# Options: openai | gemini | groq
AI_PROVIDER=gemini

# API Keys (Provide the key corresponding to your selected AI_PROVIDER)
# OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (default: gemini-3.5-flash)
# Options: gemini-3.5-flash | gemini-3.5-flash-lite | gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash

# Groq Cloud API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
